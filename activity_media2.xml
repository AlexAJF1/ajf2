<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Calculadora de Média"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/txtInfoAluno"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Aluno:\nFaculdade:"
            android:textSize="18sp"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/editNota1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Digite a 1ª nota"
            android:inputType="numberDecimal" />

        <EditText
            android:id="@+id/editNota2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Digite a 2ª nota"
            android:inputType="numberDecimal"
            android:layout_marginTop="12dp" />

        <EditText
            android:id="@+id/editNota3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Digite a 3ª nota"
            android:inputType="numberDecimal"
            android:layout_marginTop="12dp" />

        <EditText
            android:id="@+id/editNota4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Digite a 4ª nota"
            android:inputType="numberDecimal"
            android:layout_marginTop="12dp" />

        <Button
            android:id="@+id/btnCalcularMedia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Calcular Média"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/txtResultadoMedia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Resultado da média"
            android:textSize="20sp"
            android:layout_marginTop="20dp" />

        <Button
            android:id="@+id/btnIrInicioMedia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Voltar para Início"
            android:layout_marginTop="24dp" />

        <Button
            android:id="@+id/btnIrImc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ir para IMC"
            android:layout_marginTop="12dp" />

    </LinearLayout>
</ScrollView>
